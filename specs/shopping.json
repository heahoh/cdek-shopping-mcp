          "type": "integer"
        },
        "suggestion": {
          "type": "string"
        }
      }
    },
    "gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_dto_appversion.Response": {
      "type": "object",
      "properties": {
        "latestVersion": {
          "description": "Последняя опубликованная версия в формате semver",
          "type": "string",
          "example": "1.5.0"
        },
        "status": {
          "description": "Статус: required — необходимо обновиться, available — можно обновиться, not_required — обновления не требуется",
          "type": "string",
          "enum": [
            "required",
            "available",
            "not_required"
          ],
          "example": "available"
        }
      }
    },
    "gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_dto_errorresponse.BusinessLogicDto": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "code": {
          "description": "Опционален, но желателен для возможности отличать ошибки",
          "type": "string",
          "example": "incorrect_request_parameters"
        },
        "message": {
          "description": "Описание ошибки. Локализованный текст",
          "type": "string",
          "example": "Некорректные параметры запроса"
        }
      }
    },
    "gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_dto_errorresponse.TechDto": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "description": "Описание ошибки. Локализованный текст",
          "type": "string",
          "example": "Ошибка обработки запроса"
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "description": "JWT token",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}