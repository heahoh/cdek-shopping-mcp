    },
    "gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_converter_search_shopping.Response": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_converter_search_shopping.Data"
        },
        "error": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_converter_search_shopping.Suggestion": {
      "type": "object",
