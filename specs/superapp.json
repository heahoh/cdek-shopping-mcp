          {
            "type": "string",
            "description": "Язык",
            "name": "Accept-Language",
            "in": "header"
          },
          {
            "type": "integer",
            "description": "ID категории",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "enum": [
              "price_asc",
              "price_desc",
              "default_sorting",
              "sale_desc"
            ],
            "type": "string",
            "description": "По какому полю сортировка",
            "name": "sort",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Номер страницы",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "По сколько товаров выводить на страницу",
            "name": "perPage",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/gitlab_cdek-shopping_tech_cdekmarket_shopping-front-controller_internal_transport_http_converter_catalog.Response"
